# copy this file to .env (project root) and change the passwords

# MongoDB and mongo-express (used by docker-compose.yml)
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=change_me
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=change_me

# used when a service runs on the host (python user.py); in Docker the URI is built by docker-compose.yml
MONGO_URI=mongodb://root:change_me@localhost:27017/?authSource=admin
MONGO_DB=cinema
